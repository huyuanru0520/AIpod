<?xml version="1.0" encoding="utf-8"?>
<!-- 完整 iPod 点击转轮：白色实心圆盘，四向分隔缝镂空透出背景，中心 Home 键。
     单色白，落在 108dp 画布中心 66dp 安全区内，任意系统遮罩裁切后仍完整。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 轮体：白色实心圆盘，evenOdd 挖出四向分隔缝 + 中心键外环缝 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M54,21 A33,33 0 1,1 53.99,21 Z
            M52.2,20 L55.8,20 L55.8,42 L52.2,42 Z
            M52.2,66 L55.8,66 L55.8,88 L52.2,88 Z
            M20,52.2 L42,52.2 L42,55.8 L20,55.8 Z
            M66,52.2 L88,52.2 L88,55.8 L66,55.8 Z
            M54,42 A12,12 0 1,1 53.99,42 Z" />

    <!-- 中心 Home 键：白色实心圆（外圈已被上面的孔空出成红缝） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,45 A9,9 0 1,1 53.99,45 Z" />
</vector>
