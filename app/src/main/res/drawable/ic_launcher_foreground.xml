<?xml version="1.0" encoding="utf-8"?>
<!-- iPod 点击转轮缩小版：外圈轮体（玻璃环轮廓）+ 中心 Home 键 + 四个方位分隔。
     单色白，落在 108dp 画布中心 66dp 安全区内，任意系统遮罩裁切后仍完整。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外圈轮体：用环形 path（evenOdd 挖空中心），白色 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,21 A33,33 0 1,1 53.99,21 Z M54,31 A23,23 0 1,0 54.01,31 Z" />

    <!-- 中心 Home 键：实心圆 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,45 a9,9 0 1,1 0.01,0 Z" />

    <!-- 四个方位的短分隔缺口：用背景色（透明）在环上开缝，形成 MENU/上一首/下一首/播放四区 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M52.6,21.5 L55.4,21.5 L55.4,31 L52.6,31 Z" />
</vector>
